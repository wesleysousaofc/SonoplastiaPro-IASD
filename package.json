{
  "name": "sonoplastiapro-iasd",
  "productName": "SonoplastiaPro - IASD",
  "version": "1.0.2",
  "description": "SonoplastiaPro - IASD: central de vídeos, downloads e sonoplastia",
  "author": "Equipe de Sonoplastia - IASD",
  "license": "UNLICENSED",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "setup": "node scripts/setup-binaries.mjs",
    "postinstall": "node scripts/setup-binaries.mjs --if-missing",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
